        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Richard\",\n  \"email\": \"richard@example.com\",\n  \"password\": \"MyStr0ngP@ssword!\"\n}"
            },
            "url": {
              "raw": "{{endpoint}}/auth/register",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Tạo tài khoản mới. Route @Public(). Response 201 không chứa passwordHash."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"richard@example.com\",\n  \"password\": \"MyStr0ngP@ssword!\"\n}"
            },
            "url": {
              "raw": "{{endpoint}}/auth/login",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập, trả accessToken. Sai email hoặc password đều nhận 401 chung."
