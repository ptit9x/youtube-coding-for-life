        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{endpoint}}/auth/refresh",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Dùng HttpOnly refresh cookie, rotate session và trả access token mới. Gọi Login trước."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{endpoint}}/auth/logout",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revoke session phía server và clear refresh cookie."
          },
          "response": []
        }
      ]
    },
