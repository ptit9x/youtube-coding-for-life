{
  "info": {
    "_postman_id": "nestjs-base-with-ai-ep02",
    "name": "User Management API",
    "description": "Postman collection tích lũy cho User Management — EP02. Tạo environment variable endpoint = http://localhost:3000 trước khi chạy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{endpoint}}/",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Kiểm tra app đang chạy. Route @Public(), không cần token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "Paste token từ Login response, hoặc dùng biến {{accessToken}} nếu đã set."
              }
            ],
            "url": {
              "raw": "{{endpoint}}/users/me",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Trả user đang đăng nhập. Cần Bearer token hợp lệ."
          },
          "response": []
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{endpoint}}/users",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Lấy danh sách tất cả users."
          },
          "response": []
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@example.com\"\n}"
            },
            "url": {
              "raw": "{{endpoint}}/users",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Tạo user mới qua Users controller."
          },
          "response": []
        },
        {
          "name": "Find User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{endpoint}}/users/1",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "users",
                "1"
              ]
            },
            "description": "Tìm user theo ID. Thay `1` bằng ID thực tế."
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            },
            "url": {
              "raw": "{{endpoint}}/users/1",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "users",
                "1"
              ]
            },
            "description": "Cập nhật user theo ID. Thay `1` bằng ID thực tế."
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{endpoint}}/users/1",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "users",
                "1"
              ]
            },
            "description": "Xoá user theo ID. Thay `1` bằng ID thực tế."
          },
          "response": []
        },
        {
          "name": "Count Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{endpoint}}/users/count",
              "host": [
                "{{endpoint}}"
              ],
              "path": [
                "users",
                "count"
              ]
            },
            "description": "Đếm tổng số users."
          },
          "response": []
        }
      ]
    }
  ]
}
